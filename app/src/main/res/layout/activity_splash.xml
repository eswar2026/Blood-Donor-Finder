
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blood_red"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_blooddrop"
        android:tint="@color/white"/>

    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Blood Donor Finder"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Connecting donors to save lives"
        android:textColor="#FFCCCC"
        android:textSize="14sp"/>

    <ProgressBar android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/white"/>

</LinearLayout>