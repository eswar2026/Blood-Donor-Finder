
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <!--  Header Banner  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blood_red"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="28dp">

            <TextView
                android:id="@+id/tv_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hello, User 👋"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Loading donors..."
                android:textColor="#FFCCCC"
                android:textSize="14sp"/>
        </LinearLayout>
        <!--  Quick Action Cards  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:weightSum="3">
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_find_donors" android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="4dp" android:layout_weight="1" app:cardCornerRadius="12dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_person" android:tint="@color/blood_red"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Find Donors" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_view_map" android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="4dp" android:layout_weight="1" app:cardCornerRadius="12dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_map" android:tint="@color/blood_red"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="View Map" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_my_requests" android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="4dp" android:layout_weight="1" app:cardCornerRadius="12dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_blooddrop" android:tint="@color/blood_red"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="My Requests" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <!--  Recent Requests Section  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="Recent Blood Requests" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_recent_requests" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="80dp"/>
    </LinearLayout>
</ScrollView>