
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginVertical="6dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="12dp" app:cardElevation="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <!--  Profile Photo  -->
        <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/iv_photo" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_person" app:civ_border_color="@color/blood_red_light" app:civ_border_width="2dp"/>
        <!--  Donor Info  -->
        <LinearLayout
            android:layout_width="181dp"
            android:layout_height="51dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donor Name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                android:text="City, State"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_donations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 donations"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_availability"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="6dp"
                android:text="Available"
                android:textSize="11sp"
                app:chipMinHeight="28dp" />
        </LinearLayout>
        <!--  Blood Group Badge  -->
        <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_blood_group" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tv_blood_group" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O+" android:textColor="@color/blood_red" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>